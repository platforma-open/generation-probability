// Generation Probability (Pgen) workflow.
//
// Consumes one MiXCR clonotype dataset (anchor). For each chain slot it feeds the
// CDR3 sequence + per-row locus (pl7.app/vdj/chain: TRA/TRB/IGH/IGK/IGL) to OLGA,
// which computes the V(D)J generation probability. A single OLGA invocation covers
// every chain; the tool loads per-locus models on demand and routes rows by locus.
// Results are joined back onto the clonotype-key axis as per-chain PColumns.

wf := import("@platforma-sdk/workflow-tengo:workflow")
exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")
pframes := import("@platforma-sdk/workflow-tengo:pframes")
xsv := import("@platforma-sdk/workflow-tengo:pframes.xsv")
pSpec := import("@platforma-sdk/workflow-tengo:pframes.spec")
ll := import("@platforma-sdk/workflow-tengo:ll")
maps := import("@platforma-sdk/workflow-tengo:maps")
json := import("json")

olgaSw := assets.importSoftware("@platforma-open/milaboratories.generation-probability.software:main")

SEQUENCE_NAME := "pl7.app/vdj/sequence"
CHAIN_NAME := "pl7.app/vdj/chain"
CDR3_FEATURE := "CDR3"
ALPHABET_DOMAIN := "pl7.app/alphabet"
FEATURE_DOMAIN := "pl7.app/vdj/feature"
SC_CHAIN_DOMAIN := "pl7.app/vdj/scClonotypeChain"
SC_INDEX_DOMAIN := "pl7.app/vdj/scClonotypeChain/index"

PGEN_NAME := "pl7.app/vdj/generationProbability"
NEG_LOG_PGEN_NAME := "pl7.app/vdj/negLog10GenerationProbability"

// Progress line prefix printed by software/src/main.py (to stderr).
PROGRESS_PREFIX := "progress: "

// OLGA short alphabet codes expected by the tool's --alphabet flag.
alphabetCode := { "aminoacid": "aa", "nucleotide": "nt" }

// receptor -> chain slot (A = more diverse) -> {suffix, label}. A/B come from
// mixcr-clonotyping's receptorInfos (IG: heavy, light; TCRAB: beta, alpha).
scSlotInfo := {
	"IG": { "A": { suffix: "H", label: "Heavy" }, "B": { suffix: "L", label: "Light" } },
	"TCRAB": { "A": { suffix: "Beta", label: "Beta" }, "B": { suffix: "Alpha", label: "Alpha" } },
	"TCRGD": { "A": { suffix: "Delta", label: "Delta" }, "B": { suffix: "Gamma", label: "Gamma" } }
}

// Bulk clonotype-key axis carries pl7.app/vdj/chain set to the producer's chain
// KEYS (IGHeavy, ...), not the mixcr filter values. Map each to its slot info.
bulkSlotInfo := {
	"IGHeavy": { suffix: "H", label: "Heavy" },
	"IGLight": { suffix: "L", label: "Light" },
	"IGKappa": { suffix: "L", label: "Light" },
	"IGLambda": { suffix: "L", label: "Light" },
	"TCRBeta": { suffix: "Beta", label: "Beta" },
	"TCRAlpha": { suffix: "Alpha", label: "Alpha" }
}

// chain KEY -> receptor, to derive the receptor for bulk datasets and to reject
// gamma/delta (no OLGA model in the packaged distribution).
bulkChainReceptor := {
	"IGHeavy": "IG", "IGLight": "IG", "IGKappa": "IG", "IGLambda": "IG",
	"TCRAlpha": "TCRAB", "TCRBeta": "TCRAB",
	"TCRGamma": "TCRGD", "TCRDelta": "TCRGD"
}

UNSUPPORTED_GD := "Generation probability is not available for TCR gamma/delta chains: the packaged OLGA distribution ships no gamma/delta recombination model. Supported: human/mouse IGH, IGK, IGL, TRA, TRB."

// Resolve the alphabet OLGA should use from the clonotype-key structure. The key
// is built from the assembling-feature sequence + V/J; when that feature is CDR3
// the structure carries its alphabet (nucleotide keys use nSeqCDR3, aa keys use
// aaSeqCDR3). We compute Pgen on the CDR3 in that same alphabet so it matches the
// sequence that defines the clonotype. Falls back to amino acid.
resolveAlphabet := func(keyAxisSpec, isSingleCell) {
	structureKey := isSingleCell ? "pl7.app/vdj/scClonotypeKey/structure" : "pl7.app/vdj/clonotypeKey/structure"
	if is_undefined(keyAxisSpec.domain) || is_undefined(keyAxisSpec.domain[structureKey]) {
		return "aminoacid"
	}
	entries := json.decode(keyAxisSpec.domain[structureKey])
	for entry in entries {
		if entry[0] != SEQUENCE_NAME {
			continue
		}
		feature := ""
		alphabet := ""
		for idx, pair in entry {
			if idx == 0 {
				continue
			}
			if pair[0] == FEATURE_DOMAIN {
				feature = pair[1]
			}
			if pair[0] == ALPHABET_DOMAIN {
				alphabet = pair[1]
			}
		}
		if feature == CDR3_FEATURE && alphabet != "" {
			return alphabet
		}
	}
	return "aminoacid"
}

wf.prepare(func(args) {
	bb := wf.createPBundleBuilder()
	bb.ignoreMissingDomains()
	bb.addAnchor("main", json.decode(args.inputAnchor))

	// CDR3 sequence columns for BOTH alphabets (the body picks one). Single-cell
	// emits one per (slot x primary/secondary allele); bulk emits one.
	bb.addMulti({
		axes: [{ anchor: "main", idx: 1 }],
		name: SEQUENCE_NAME,
		domain: { "pl7.app/vdj/feature": CDR3_FEATURE }
	}, "cdr3")

	// Per-row locus column (mixcr "topChains"). Value is the OLGA locus directly.
	bb.addMulti({
		axes: [{ anchor: "main", idx: 1 }],
		name: CHAIN_NAME
	}, "chains")

	return { columns: bb.build() }
})

wf.body(func(args) {
	columns := args.columns
	datasetSpec := columns.getSpec(json.decode(args.inputAnchor))
	keyAxisSpec := datasetSpec.axesSpec[1]
	isSingleCell := keyAxisSpec.name == "pl7.app/vdj/scClonotypeKey"

	// Receptor + gamma/delta reject.
	receptor := ""
	if isSingleCell {
		receptor = keyAxisSpec.domain["pl7.app/vdj/receptor"]
	} else {
		receptor = bulkChainReceptor[keyAxisSpec.domain[CHAIN_NAME]]
	}
	if receptor == "TCRGD" {
		ll.panic(UNSUPPORTED_GD)
	}

	alphabet := resolveAlphabet(keyAxisSpec, isSingleCell)
	ll.assert(!is_undefined(alphabet), "unsupported alphabet: %s", alphabet)

	// Group the CDR3 sequence column and the locus column per chain slot, keeping
	// only the primary allele for single-cell (secondary lacks nt CDR3 / locus).
	slots := {}
	assignSlot := func(col, kind) {
		domain := col.spec.domain
		if isSingleCell && domain[SC_INDEX_DOMAIN] != "primary" {
			return
		}
		slot := isSingleCell ? domain[SC_CHAIN_DOMAIN] : ""
		if is_undefined(slots[slot]) {
			slots[slot] = {}
		}
		slots[slot][kind] = col
	}
	for col in columns.getColumns("cdr3") {
		if col.spec.domain[ALPHABET_DOMAIN] == alphabet {
			assignSlot(col, "seq")
		}
	}
	for col in columns.getColumns("chains") {
		assignSlot(col, "chain")
	}

	slotInfoFor := func(slot) {
		if isSingleCell {
			return scSlotInfo[receptor][slot]
		}
		return bulkSlotInfo[keyAxisSpec.domain[CHAIN_NAME]]
	}

	// Build, in one pass: the input parquet (key + per-slot seq/locus columns),
	// the parallel per-slot CLI argument lists, and the import column specs.
	parquetBuilder := pframes.parquetFileBuilder()
	parquetBuilder.setAxisHeader(keyAxisSpec, "clonotypeKey")
	parquetBuilder.cpu(1)
	parquetBuilder.mem("8GiB")

	seqArgs := []
	chainArgs := []
	pgenArgs := []
	negLogArgs := []
	importColumns := []

	orderedSlots := isSingleCell ? ["A", "B"] : [""]
	for slot in orderedSlots {
		unit := slots[slot]
		if is_undefined(unit) || is_undefined(unit.seq) || is_undefined(unit.chain) {
			continue
		}
		info := slotInfoFor(slot)
		if is_undefined(info) {
			continue
		}
		suffix := info.suffix
		slotTag := slot == "" ? "x" : slot

		seqHeader := "seq_" + slotTag
		chainHeader := "chain_" + slotTag
		pgenHeader := "Pgen_" + suffix
		negLogHeader := "neg_log_Pgen_" + suffix

		parquetBuilder.add(unit.seq, { header: seqHeader })
		parquetBuilder.add(unit.chain, { header: chainHeader })

		seqArgs = append(seqArgs, seqHeader)
		chainArgs = append(chainArgs, chainHeader)
		pgenArgs = append(pgenArgs, pgenHeader)
		negLogArgs = append(negLogArgs, negLogHeader)

		valueDomain := {}
		if isSingleCell {
			valueDomain = { "pl7.app/vdj/scClonotypeChain": slot }
		}
		importColumns = append(importColumns, {
			column: pgenHeader,
			id: "pgen-" + suffix,
			allowNA: true,
			spec: {
				name: PGEN_NAME,
				valueType: "Double",
				domain: valueDomain,
				annotations: {
					"pl7.app/label": "Pgen (" + info.label + ")",
					"pl7.app/table/orderPriority": "80000"
				}
			}
		})
		importColumns = append(importColumns, {
			column: negLogHeader,
			id: "neglog-" + suffix,
			allowNA: true,
			spec: {
				name: NEG_LOG_PGEN_NAME,
				valueType: "Double",
				domain: valueDomain,
				annotations: {
					"pl7.app/label": "-log10(Pgen) (" + info.label + ")",
					"pl7.app/isScore": "true",
					"pl7.app/table/orderPriority": "90000"
				}
			}
		})
	}

	ll.assert(len(seqArgs) > 0, "no supported chain found in the input dataset")

	inputParquet := parquetBuilder.build()

	cmd := exec.builder().
		software(olgaSw).
		cpu(8).
		mem("16GiB").
		addFile("input.parquet", inputParquet).
		arg("--input").arg("input.parquet").
		arg("--output").arg("result.parquet").
		arg("--species").arg(args.species).
		arg("--alphabet").arg(alphabet).
		arg("--key-column").arg("clonotypeKey").
		arg("--workers").arg("8")

	for idx, seqHeader in seqArgs {
		cmd = cmd.
			arg("--sequence-column").arg(seqHeader).
			arg("--chain-column").arg(chainArgs[idx]).
			arg("--pgen-column").arg(pgenArgs[idx]).
			arg("--neg-log-pgen-column").arg(negLogArgs[idx])
	}

	result := cmd.
		saveFile("result.parquet").
		printErrStreamToStdout().
		saveStdoutStream().
		cache(24 * 60 * 60 * 1000).
		run()

	imported := xsv.importFile(result.getFile("result.parquet"), "parquet", {
		axes: [{ column: "clonotypeKey", spec: keyAxisSpec }],
		columns: importColumns,
		storageFormat: "Parquet",
		partitionKeyLength: 0
	}, { splitDataAndSpec: true, cpu: 1, mem: "8GiB" })

	traceLabel := "Generation Probability"
	if !is_undefined(datasetSpec.annotations) && !is_undefined(datasetSpec.annotations["pl7.app/label"]) {
		traceLabel = datasetSpec.annotations["pl7.app/label"]
	}
	trace := pSpec.makeTrace(datasetSpec, {
		type: "milaboratories.generation-probability",
		importance: 30,
		label: traceLabel
	})

	frameBuilder := pframes.pFrameBuilder()
	for k in maps.getKeys(imported) {
		entry := imported[k]
		frameBuilder.add(k, trace.inject(entry.spec), entry.data)
	}
	pgenFrame := frameBuilder.build()

	return {
		outputs: {
			pgenPf: pframes.exportFrame(pgenFrame),
			progress: result.getStdoutStream()
		},
		exports: {
			pgen: pgenFrame
		}
	}
})
