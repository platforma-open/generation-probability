self := import("@platforma-sdk/workflow-tengo:tpl")
exec := import("@platforma-sdk/workflow-tengo:exec")
f := import("@platforma-sdk/workflow-tengo:exec.formula")
assets := import("@platforma-sdk/workflow-tengo:assets")
pframes := import("@platforma-sdk/workflow-tengo:pframes")
pSpec := import("@platforma-sdk/workflow-tengo:pframes.spec")
xsv := import("@platforma-sdk/workflow-tengo:pframes.xsv")

pgenSw := assets.importSoftware("@platforma-open/milaboratories.generation-probability.software:main")

self.defineOutputs("pgenPf", "exportPf", "progress")

self.body(func(args) {
	params := args.params
	units := params.units

	// The raw joined table can go straight to the tool: OLGA never throws on
	// non-productive CDR3 (stop '*' scores; frameshift/empty/out-of-frame score 0),
	// main.py drops null/NA cells before scoring, and unmodeled chains return null
	// pgen instead of crashing. So no input sanitizing is needed here.
	cmd := exec.builder().
		software(pgenSw).
		addFile("input.parquet", args.inputTable, { tag: "input" }).
		arg("--input").arg("input.parquet").
		arg("--output").arg("result.parquet").
		arg("--species").arg(params.species).
		arg("--alphabet").arg(params.alphabet).
		arg("--key-column").arg("clonotypeKey")
	for unit in units {
		cmd = cmd.arg("--sequence-column").arg("cdr3_" + unit.suffix)
		cmd = cmd.arg("--chain-column").arg("chain_" + unit.suffix)
		cmd = cmd.arg("--pgen-column").arg("pgen_" + unit.suffix)
		cmd = cmd.arg("--neg-log-pgen-column").arg("neglog_" + unit.suffix)
	}
	cmd = cmd.arg("--workers").argExpr("{system.cpu}")

	// Resources scale with the input parquet size (bytes track clonotype count). pgen is
	// CPU-bound and embarrassingly parallel — main.py fans out over --workers and streams
	// the parquet — so CPU ~ 1 core/MiB clamped [2, 16]; RAM ~ 4x input (decompressed
	// strings + ~130 MB/worker) floored at 4 GiB, capped at 32 GiB. Static fallbacks cover
	// backends that can't evaluate formulas; heavy queue — a big repertoire is minutes-long.
	run := cmd.
		saveFile("result.parquet").
		saveStderrStream().
		resources({
			queue: "heavy",
			onCPU: {
				cpu: f.size("input").dividedBy(f.mib(1)).between(2, 16).staticFallback(8),
				ram: f.size("input").times(4).between(f.gib(4), f.gib(32)).staticFallback(f.gib(8))
			}
		}).
		run()

	resultTable := run.getFile("result.parquet")

	trace := pSpec.makeTrace({ annotations: params.traceAnnotations }, {
		type: "milaboratories.generation-probability",
		importance: 30,
		label: "Generation Probability"
	})

	// pgen is the enrichment anchor the model reads; neg-log10 is the human-readable
	// score (higher = rarer). Both columns are imported keyed by the clonotype axis.
	columnSpecs := []
	orderedIds := []
	for unit in units {
		pgenId := "pgen_" + unit.suffix
		negId := "neglog_" + unit.suffix

		domain := { "pl7.app/alphabet": params.alphabet }
		if params.isSingleCell {
			domain["pl7.app/vdj/scClonotypeChain"] = unit.scChain
			domain["pl7.app/vdj/scClonotypeChain/index"] = "primary"
		}

		labelSuffix := ""
		if !is_undefined(unit.label) && unit.label != "" {
			labelSuffix = " (" + unit.label + ")"
		}

		columnSpecs += [{
			column: pgenId,
			id: pgenId,
			allowNA: true,
			spec: {
				name: "pl7.app/vdj/generationProbability",
				valueType: "Double",
				domain: domain,
				annotations: {
					"pl7.app/label": "Generation probability" + labelSuffix,
					"pl7.app/format": ".2e",
					"pl7.app/table/visibility": "default",
					"pl7.app/table/orderPriority": unit.priority
				}
			}
		}, {
			column: negId,
			id: negId,
			allowNA: true,
			spec: {
				name: "pl7.app/vdj/minlog10GenerationProbability",
				valueType: "Double",
				domain: domain,
				annotations: {
					"pl7.app/label": "-log10 generation probability" + labelSuffix,
					"pl7.app/format": ".2f",
					"pl7.app/table/visibility": "default",
					"pl7.app/table/orderPriority": unit.priority,
					"pl7.app/isScore": "true",
					"pl7.app/score/rankingOrder": "decreasing"
				}
			}
		}]
		orderedIds += [pgenId, negId]
	}

	imported := xsv.importFile(resultTable, "parquet", {
		axes: [{ column: "clonotypeKey", spec: params.keySpec }],
		columns: columnSpecs,
		storageFormat: "Parquet",
		partitionKeyLength: 0
	}, { splitDataAndSpec: true, cpu: 1, mem: "4GiB" })

	// The plain frame drives the UI table; the export frame carries the trace downstream.
	outputBuilder := pframes.pFrameBuilder()
	exportBuilder := pframes.pFrameBuilder()
	for id in orderedIds {
		column := imported[id]
		outputBuilder.add(id, column.spec, column.data)
		exportBuilder.add(id, trace.inject(column.spec), column.data)
	}

	return {
		pgenPf: pframes.exportFrame(outputBuilder.build()),
		exportPf: exportBuilder.build(),
		progress: run.getStderrStream()
	}
})
